<Window x:Class="FileRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일 이름 일괄 변경" Width="920" Height="680" MinWidth="720" MinHeight="520"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 파일 목록 도구 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="파일 추가" Click="OnAddFiles" />
            <Button Content="선택 삭제" Command="{Binding RemoveSelectedCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=FileGrid}" />
            <Button Content="전체 비우기" Command="{Binding ClearCommand}" />
            <Button Content="▲ 위" Command="{Binding MoveUpCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=FileGrid}" Margin="18,0,6,0" />
            <Button Content="▼ 아래" Command="{Binding MoveDownCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=FileGrid}" />
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" />
        </StackPanel>

        <!-- 파일 목록 -->
        <Grid Grid.Row="1">
            <DataGrid x:Name="FileGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="False"
                      CanUserReorderColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" AllowDrop="True"
                      PreviewMouseLeftButtonDown="OnGridMouseDown" PreviewMouseMove="OnGridMouseMove"
                      DragOver="OnDragOver" Drop="OnDrop">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                <Setter Property="Background" Value="#FFFFCDD2" />
                                <Setter Property="Foreground" Value="#FFB71C1C" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="현재 이름" Binding="{Binding CurrentName}" Width="*" />
                    <DataGridTextColumn Header="새 이름" Binding="{Binding NewName}" Width="*" />
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="여기에 파일이나 폴더를 끌어다 놓으세요" Foreground="Gray" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoRows}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 모드 선택 -->
        <TabControl Grid.Row="2" Margin="0,10,0,0" SelectedIndex="{Binding ModeIndex}">
            <TabItem Header="찾아 바꾸기">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="찾을 글자" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ReplaceFind, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="바꿀 글자" Style="{StaticResource FieldLabel}" Margin="0,6,10,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Content="정규식 사용" IsChecked="{Binding UseRegex}" />
                </Grid>
            </TabItem>
            <TabItem Header="템플릿">
                <StackPanel Margin="10">
                    <TextBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,6,0,0" Foreground="Gray"
                               Text="변수: {날짜} 오늘 날짜 (설정의 형식)   {회사명}   {이름}   {파일명} 원래 이름(확장자 제외)" />
                </StackPanel>
            </TabItem>
            <TabItem Header="대소문자">
                <StackPanel Margin="10" Orientation="Horizontal">
                    <TextBlock Text="변환 방식" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="260" SelectedIndex="{Binding CaseIndex}">
                        <ComboBoxItem Content="전체 소문자" />
                        <ComboBoxItem Content="전체 대문자" />
                        <ComboBoxItem Content="첫 글자만 대문자" />
                        <ComboBoxItem Content="단어마다 첫 글자 대문자" />
                    </ComboBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="순번">
                <StackPanel Margin="10" Orientation="Horizontal">
                    <TextBlock Text="기본 이름" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="200" Text="{Binding SeqBaseName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="시작 번호" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                    <TextBox Width="60" Text="{Binding SeqStart, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="자릿수" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                    <TextBox Width="50" Text="{Binding SeqDigits, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="구분자" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                    <ComboBox Width="90" SelectedIndex="{Binding SeqSepIndex}">
                        <ComboBoxItem Content="공백" />
                        <ComboBoxItem Content="_ (밑줄)" />
                        <ComboBoxItem Content="- (하이픈)" />
                        <ComboBoxItem Content="없음" />
                    </ComboBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 규칙 오류 -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#FFC62828" TextWrapping="Wrap" Margin="2,6,0,0" />

        <!-- 하단 버튼 -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="설정" Click="OnSettings" />
            <Button DockPanel.Dock="Right" Content="적용" Command="{Binding ApplyCommand}" FontWeight="Bold" Padding="28,6" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="되돌리기" Command="{Binding UndoCommand}" />
        </DockPanel>
    </Grid>
</Window>
