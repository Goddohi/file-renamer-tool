<Window x:Class="FileRenamer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileRenamer.App"
        Title="파일 이름 일괄 변경" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Style="{StaticResource WindowStyle}"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Closing="OnClosing" SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <local:IndexConverter x:Key="Index" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolbarText" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <Style x:Key="CountChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="9,3" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        </Style>

        <Style x:Key="OldName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NewName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Foreground" Value="{DynamicResource BadFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Unchanged">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="None">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Unchanged">
                    <Setter Property="Background" Value="{DynamicResource SameBgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource OkFgBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Unchanged">
                    <Setter Property="Foreground" Value="{DynamicResource SameFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Foreground" Value="{DynamicResource BadFgBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                    <Setter Property="Background" Value="{DynamicResource RowBadBrush}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelBrush}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="Conflict" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource RowBadSelBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Grid.Row="0" Margin="24,14,24,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M14,3 H6 A2,2 0 0 0 4,5 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V9 Z M14,3 V9 H20 M8,15 H13 M11,12 L13,15 L11,18" />
                <TextBlock Text="파일 이름 일괄 변경" FontSize="15" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Click="OnSettings" MinHeight="36" AutomationProperties.Name="설정">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Path Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
                        <Ellipse Width="6" Height="6" StrokeThickness="1.6" Stroke="{DynamicResource TextBrush}" />
                    </Grid>
                    <TextBlock Text="설정" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 본문 -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 규칙 패널 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
                <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="변경 방식" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource SegmentGroup}">
                            <UniformGrid Columns="2">
                                <RadioButton GroupName="Mode" Style="{StaticResource SegmentRadio}" Content="찾아 바꾸기" Margin="0,0,2,2"
                                             IsChecked="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=0}" />
                                <RadioButton GroupName="Mode" Style="{StaticResource SegmentRadio}" Content="템플릿" Margin="2,0,0,2"
                                             IsChecked="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=1}" />
                                <RadioButton GroupName="Mode" Style="{StaticResource SegmentRadio}" Content="대소문자" Margin="0,2,2,0"
                                             IsChecked="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=2}" />
                                <RadioButton GroupName="Mode" Style="{StaticResource SegmentRadio}" Content="순번" Margin="2,2,0,0"
                                             IsChecked="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=3}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,22,0,22">
                        <StackPanel>
                            <!-- 0: 찾아 바꾸기 -->
                            <StackPanel Visibility="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=0}">
                                <TextBlock Text="찾을 글자" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ReplaceFind, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="찾을 글자" />
                                <TextBlock Text="바꿀 글자" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="바꿀 글자" />
                                <TextBlock Text="비워 두면 찾은 글자를 지웁니다." Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                <CheckBox IsChecked="{Binding UseRegex}" MinHeight="40" Margin="0,8,0,0">
                                    <DockPanel Width="220" LastChildFill="False">
                                        <TextBlock Text="정규식 사용" DockPanel.Dock="Left" />
                                        <TextBlock Text=".NET Regex" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                </CheckBox>
                            </StackPanel>

                            <!-- 1: 템플릿 -->
                            <StackPanel Visibility="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=1}">
                                <TextBlock Text="새 이름 템플릿" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TemplateBox" AutomationProperties.Name="새 이름 템플릿" Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="변수를 눌러 커서 위치에 넣습니다." Style="{StaticResource Muted}" Margin="0,6,0,10" />
                                <StackPanel>
                                    <Button Style="{StaticResource ChipButton}" Click="OnInsertVariable" Tag="{}{날짜}" AutomationProperties.Name="날짜 변수 넣기">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{날짜}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DateSample}" ToolTip="{Binding DateSample}" Style="{StaticResource Muted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource ChipButton}" Click="OnInsertVariable" Tag="{}{회사명}" AutomationProperties.Name="회사명 변수 넣기">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{회사명}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompanyName}" ToolTip="{Binding CompanyName}" Style="{StaticResource Muted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource ChipButton}" Click="OnInsertVariable" Tag="{}{이름}" AutomationProperties.Name="이름 변수 넣기">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{이름}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding UserName}" ToolTip="{Binding UserName}" Style="{StaticResource Muted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource ChipButton}" Click="OnInsertVariable" Tag="{}{파일명}" AutomationProperties.Name="파일명 변수 넣기">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{파일명}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="확장자를 뺀 현재 파일명 · 확장자는 그대로 유지됩니다.">
                                                <TextBlock.Text>
                                                    <PriorityBinding FallbackValue="파일을 추가하세요">
                                                        <Binding Path="SelectedItem.FileNameStem" ElementName="FileGrid" />
                                                        <Binding Path="Rows/FileNameStem" />
                                                    </PriorityBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- 2: 대소문자 -->
                            <StackPanel Visibility="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=2}">
                                <TextBlock Text="변환 방식" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <RadioButton GroupName="Case" Style="{StaticResource OptionRadio}" Content="전체 소문자"
                                             IsChecked="{Binding CaseIndex, Converter={StaticResource Index}, ConverterParameter=0}" />
                                <RadioButton GroupName="Case" Style="{StaticResource OptionRadio}" Content="전체 대문자"
                                             IsChecked="{Binding CaseIndex, Converter={StaticResource Index}, ConverterParameter=1}" />
                                <RadioButton GroupName="Case" Style="{StaticResource OptionRadio}" Content="첫 글자만 대문자"
                                             IsChecked="{Binding CaseIndex, Converter={StaticResource Index}, ConverterParameter=2}" />
                                <RadioButton GroupName="Case" Style="{StaticResource OptionRadio}" Content="단어마다 첫 글자 대문자"
                                             IsChecked="{Binding CaseIndex, Converter={StaticResource Index}, ConverterParameter=3}" />
                            </StackPanel>

                            <!-- 3: 순번 -->
                            <StackPanel Visibility="{Binding ModeIndex, Converter={StaticResource Index}, ConverterParameter=3}">
                                <TextBlock Text="기본 이름" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SeqBaseName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="기본 이름" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="시작 번호" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SeqStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="시작 번호" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="자릿수" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SeqDigits, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="자릿수" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="구분자" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <UniformGrid Columns="4">
                                        <RadioButton GroupName="Sep" Style="{StaticResource SegmentRadio}" Content="공백" Margin="0,0,2,0"
                                                     IsChecked="{Binding SeqSepIndex, Converter={StaticResource Index}, ConverterParameter=0}" />
                                        <RadioButton GroupName="Sep" Style="{StaticResource SegmentRadio}" Content="_" Margin="2,0"
                                                     IsChecked="{Binding SeqSepIndex, Converter={StaticResource Index}, ConverterParameter=1}" />
                                        <RadioButton GroupName="Sep" Style="{StaticResource SegmentRadio}" Content="-" Margin="2,0"
                                                     IsChecked="{Binding SeqSepIndex, Converter={StaticResource Index}, ConverterParameter=2}" />
                                        <RadioButton GroupName="Sep" Style="{StaticResource SegmentRadio}" Content="없음" Margin="2,0,0,0"
                                                     IsChecked="{Binding SeqSepIndex, Converter={StaticResource Index}, ConverterParameter=3}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- 규칙 오류 -->
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BadFgBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- 설정 요약 -->
                    <Border Grid.Row="2" Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="편집" Click="OnSettings" />
                                <TextBlock Text="설정" Style="{StaticResource Muted}" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="날짜" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DateSample}" ToolTip="{Binding DateSample}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="회사명" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompanyName}" ToolTip="{Binding CompanyName}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Text="이름" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserName}" ToolTip="{Binding UserName}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Text="화면" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ThemeName}" ToolTip="{Binding ThemeName}" TextTrimming="CharacterEllipsis" FontSize="13" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- 파일 목록 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 도구 모음 -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Style="{StaticResource AccentButton}" Click="OnAddFiles" Margin="0,0,6,0" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,5 V19 M5,12 H19" />
                                        <TextBlock Text="파일 추가" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolbarText}" Content="선택 삭제" Command="{Binding RemoveSelectedCommand}"
                                        CommandParameter="{Binding SelectedItems, ElementName=FileGrid}" />
                                <Button Style="{StaticResource ToolbarText}" Content="전체 비우기" Command="{Binding ClearCommand}" />
                                <Border Style="{StaticResource Divider}" />
                                <Button Style="{StaticResource IconButton}" Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedItem, ElementName=FileGrid}"
                                        AutomationProperties.Name="위로" ToolTip="위로">
                                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,15 L12,9 L18,15" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedItem, ElementName=FileGrid}"
                                        AutomationProperties.Name="아래로" ToolTip="아래로">
                                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,9 L12,15 L18,9" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                                <Border Style="{StaticResource CountChip}" Background="{DynamicResource OkBgBrush}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource OkFgBrush}">
                                        <Run Text="변경" /> <Run Text="{Binding ChangedCount, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource CountChip}" Background="{DynamicResource SameBgBrush}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SameFgBrush}">
                                        <Run Text="그대로" /> <Run Text="{Binding UnchangedCount, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource CountChip}" Background="{DynamicResource BadBgBrush}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource BadFgBrush}">
                                        <Run Text="충돌" /> <Run Text="{Binding ConflictCount, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- 표 -->
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="FileGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  RowStyle="{StaticResource FileRowStyle}" AllowDrop="True"
                                  PreviewMouseLeftButtonDown="OnGridMouseDown" PreviewMouseMove="OnGridMouseMove"
                                  DragOver="OnDragOver" Drop="OnDrop">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="52" MinWidth="52">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource OldName}" />
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="현재 이름" Width="1*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource OldName}" ToolTip="{Binding CurrentName}" local:DiffText.Segments="{Binding OldSegments}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="44" MinWidth="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M5,12 H19 M13,6 L19,12 L13,18" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="새 이름" Width="1*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource NewName}" ToolTip="{Binding NewName}" local:DiffText.Segments="{Binding NewSegments}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="상태" Width="128" MinWidth="128">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusChip}">
                                                <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="폴더" Width="0.8*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 빈 목록 안내 -->
                        <Grid Margin="24" VerticalAlignment="Center" IsHitTestVisible="False"
                              Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}">
                            <Rectangle Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
                            <StackPanel Margin="24,32">
                                <TextBlock Text="여기에 파일이나 폴더를 끌어다 놓으세요" FontSize="15" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="행을 끌어서 순서를 바꿀 수 있습니다" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 하단 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
                        MinHeight="38" Padding="28,0" Margin="12,0,0,0" FontWeight="Bold" />
                <Button DockPanel.Dock="Right" Content="되돌리기" Command="{Binding UndoCommand}" Background="{DynamicResource TransparentBrush}" MinHeight="38" Padding="18,0" />
                <Grid VerticalAlignment="Center" Margin="0,0,12,0"
                      Visibility="{Binding HasConflictMessage, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource BadFgBrush}" StrokeThickness="2" />
                        <Path Stretch="None" Stroke="{DynamicResource BadFgBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M9,5 V10 M9,13 V13.1" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding ConflictMessage}" ToolTip="{Binding ConflictMessage}" Foreground="{DynamicResource BadFgBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
