<Window x:Class="FileRenamer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Icon="/Assets/app.ico" Width="520" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource WindowStyle}" Background="{DynamicResource SurfaceBrush}"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <!-- 화면 모드 선택 카드: Tag = 라벨, Content = 미리보기 -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="1">
                            <StackPanel>
                                <ContentPresenter />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse x:Name="Dot" Width="14" Height="14" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Tag}" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Margin" Value="0" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="설정" FontSize="18" FontWeight="Bold" Margin="24,20,24,0" />

        <StackPanel Grid.Row="1" Margin="24,20,24,22">
            <!-- 화면 모드 -->
            <TextBlock Text="화면 모드" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
            <UniformGrid Columns="2">
                <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Style="{StaticResource ThemeCard}" Tag="일반 모드" AutomationProperties.Name="일반 모드" Margin="0,0,6,0">
                    <Border Background="{DynamicResource BgBrush}" CornerRadius="6" Height="88" Padding="8">
                        <Border.Resources><ResourceDictionary Source="Themes/Light.xaml" /></Border.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="66*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" CornerRadius="3" Height="14" Margin="0,0,0,5" />
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" CornerRadius="3" Height="14" Margin="0,0,0,5" />
                                <Border Background="{DynamicResource BadBgBrush}" CornerRadius="3" Height="14" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>
                <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Style="{StaticResource ThemeCard}" Tag="다크 모드" AutomationProperties.Name="다크 모드" Margin="6,0,0,0">
                    <Border Background="{DynamicResource BgBrush}" CornerRadius="6" Height="88" Padding="8">
                        <Border.Resources><ResourceDictionary Source="Themes/Dark.xaml" /></Border.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="66*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" CornerRadius="3" Height="14" Margin="0,0,0,5" />
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" CornerRadius="3" Height="14" Margin="0,0,0,5" />
                                <Border Background="{DynamicResource BadBgBrush}" CornerRadius="3" Height="14" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </RadioButton>
            </UniformGrid>

            <!-- 날짜 형식 -->
            <TextBlock Text="날짜 형식" FontSize="13" FontWeight="Bold" Margin="0,22,0,6" />
            <TextBox x:Name="DateFormatBox" AutomationProperties.Name="날짜 형식" TextChanged="OnDateFormatChanged" />
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Muted}" Text="예: yyyyMMdd, yyyy-MM-dd, yyMMdd · " />
                <TextBlock x:Name="SampleText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
            </WrapPanel>

            <!-- 회사명 / 이름 -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="회사명" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="CompanyBox" AutomationProperties.Name="회사명" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="이름" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="UserBox" AutomationProperties.Name="이름" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 하단 버튼 -->
        <Border Grid.Row="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="확인" MinWidth="96" MinHeight="38"
                        IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
                <Button Content="취소" MinWidth="96" MinHeight="38" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
