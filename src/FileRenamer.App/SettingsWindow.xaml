<Window x:Class="FileRenamer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="날짜 형식" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBox x:Name="DateFormatBox" Grid.Row="0" Grid.Column="1" Padding="3" TextChanged="OnDateFormatChanged" />
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Foreground="Gray"
                   Text=".NET 형식 문자열 (예: yyyyMMdd, yyyy-MM-dd, yyMMdd)" />
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SampleText" Margin="0,4,0,0" />

        <TextBlock Grid.Row="3" Text="회사명" VerticalAlignment="Center" Margin="0,14,12,0" />
        <TextBox x:Name="CompanyBox" Grid.Row="3" Grid.Column="1" Padding="3" Margin="0,14,0,0" />

        <TextBlock Grid.Row="4" Text="이름" VerticalAlignment="Center" Margin="0,8,12,0" />
        <TextBox x:Name="UserBox" Grid.Row="4" Grid.Column="1" Padding="3" Margin="0,8,0,0" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="확인" Width="80" Padding="0,5" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="취소" Width="80" Padding="0,5" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
